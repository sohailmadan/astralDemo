# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_ — this bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Local dev-only escape hatch (see lib/ai/openrouter.ts): routes generation/tutor calls to a
# locally-running Ollama instead of OpenRouter — never used in production, and irrelevant to
# the brief's "free OpenRouter models only" requirement, which is about what's deployed. Useful
# when OpenRouter's daily free-tier quota is exhausted and local testing needs to continue.
# Pick models sized to your actual available RAM — a large model (e.g. a 13GB+ file like
# gpt-oss:20b) can make a machine with modest RAM (e.g. 16GB total) unresponsive, since the OS
# and everything else still needs headroom alongside it. Separate models per role, found
# directly by testing: a general-purpose chat model (llama3.2:3b) handles the tutor's plain
# chat/tool-calling fine, but produced genuine JSX/TSX syntax errors on every codegen attempt —
# a code-specialized model (qwen2.5-coder:3b) is used for that role instead. Both ~2GB.
# Requires `ollama pull <model>` for each and `ollama serve` running.
# USE_LOCAL_OLLAMA=true
# OLLAMA_CODEGEN_MODEL=qwen2.5-coder:3b
# OLLAMA_TUTOR_MODEL=llama3.2:3b

# A second, real-cost dev escalation for codegen specifically (see lib/ai/openrouter.ts) — for
# when a free/local model's failures are genuinely about capability (e.g. qwen2.5-coder:3b
# generated code that compiled and ran but never called bridge.registerAction() at all, a
# contract-compliance gap no repair-loop retry fixes) rather than something a better prompt or
# retry can fix. NOT a production model choice — takes priority over USE_LOCAL_OLLAMA for
# codegen only; the tutor role is unaffected. Real, paid-per-token OpenAI API calls.
# USE_OPENAI_CODEGEN=true
# OPENAI_API_KEY=your-openai-key
# OPENAI_CODEGEN_MODEL=gpt-4.1-mini

# Langfuse (free tier) — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
